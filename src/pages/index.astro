---
import '@fontsource/ibm-plex-sans/400.css';
import '@fontsource/ibm-plex-sans/500.css';
import '@fontsource/ibm-plex-sans/600.css';
import '@fontsource/ibm-plex-mono/400.css';
import '@fontsource/ibm-plex-mono/500.css';
import '../styles/global.css';
import Deck from '../components/deck/Deck';
import { deckMeta } from '../data/deck';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#08080a" />
    <title>{deckMeta.title} · {deckMeta.institution}</title>
    <meta name="description" content={`${deckMeta.title} — ${deckMeta.program}, presented at ${deckMeta.institution}.`} />
    <link rel="icon" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 32'%3E%3Crect width='32' height='32' rx='8' fill='%2308080a'/%3E%3Ccircle cx='16' cy='16' r='6' fill='%23ff5c1f'/%3E%3C/svg%3E" />
  </head>
  <body>
    <Deck client:only="react" />
    <noscript><p style="padding:2rem">This presentation needs JavaScript.</p></noscript>
  </body>
</html>
